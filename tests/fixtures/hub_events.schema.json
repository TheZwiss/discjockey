    {
      "$ref": "#/$defs/JobStarted"
    },
    {
      "$ref": "#/$defs/JobFinished"
    },
    {
      "$ref": "#/$defs/ConsoleBusy"
    },
    {
      "$ref": "#/$defs/FileDropped"
