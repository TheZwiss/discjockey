      "properties": {
        "type": {
          "const": "RunStarted"
        },
        "total": {
          "type": "integer"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlannedAction"
          }
        }
      },
      "required": [
        "type",
        "total",
        "actions"
      ],
      "additionalProperties": false
    },
