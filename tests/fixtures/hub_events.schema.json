    },
    {
      "$ref": "#/$defs/StepChanged"
    },
    {
      "$ref": "#/$defs/Progress"
    },
    {
      "$ref": "#/$defs/Waiting"
    },
    {
      "$ref": "#/$defs/SourceChosen"
    },
    {
      "$ref": "#/$defs/Checked"
    },
    {
      "$ref": "#/$defs/AccountUsage"
    },
    {
      "$ref": "#/$defs/ActionFinished"
    },
    {
      "$ref": "#/$defs/RunFinished"
    },
    {
      "$ref": "#/$defs/Message"
    },
    {
      "$ref": "#/$defs/ReadingPlaylist"
    },
    {
      "$ref": "#/$defs/MovesProgress"
    },
    {
      "$ref": "#/$defs/ImportProgress"
