      "type": "object",
      "properties": {
        "type": {
          "const": "ActionStarted"
        },
        "index": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "action": {
          "$ref": "#/$defs/Action"
        }
      },
      "required": [
        "type",
        "index",
        "total",
        "action"
      ],
      "additionalProperties": false
