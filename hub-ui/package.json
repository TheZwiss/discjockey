{
  "name": "discjockey-hub-ui",
  "private": true,
  "license": "GPL-3.0-only",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode fake --strictPort",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "verify": "npm run check && npm run test && vite build --outDir .verify-dist --emptyOutDir && node scripts/rules.mjs --self-test && node scripts/rules.mjs",
    "shots": "node scripts/shots.mjs",
    "rules": "node scripts/rules.mjs",
    "smoke": "node scripts/smoke-built.mjs",
    "strings": "node scripts/strings.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "playwright": "1.64.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  }
}
