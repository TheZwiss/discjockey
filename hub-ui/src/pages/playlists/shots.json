[
 {
  "name": "playlists-reorder",
  "route": "#/playlists",
  "scenario": "normal",
  "steps": [
   {
    "wait": "[data-test=row-Powertrance]"
   },
   {
    "eval": "(() => { const h = document.querySelector('[data-test=handle-Powertrance]'); const r = h.getBoundingClientRect(); const x = r.left + r.width / 2, y = r.top + r.height / 2; const top = document.querySelector('[data-test=row-Hard_Bounce]').getBoundingClientRect().top; const o = (yy) => ({ bubbles: true, cancelable: true, clientX: x, clientY: yy, button: 0, pointerId: 1, isPrimary: true }); h.dispatchEvent(new PointerEvent('pointerdown', o(y))); window.dispatchEvent(new PointerEvent('pointermove', o((y + top) / 2))); window.dispatchEvent(new PointerEvent('pointermove', o(top - 4))); window.dispatchEvent(new PointerEvent('pointerup', o(top - 4))); })()"
   },
   {
    "wait": "[data-test=delta-Powertrance]"
   },
   {
    "wait": "[data-test=save]:not([aria-disabled=true])"
   },
   {
    "sleep": 600
   }
  ]
 },
