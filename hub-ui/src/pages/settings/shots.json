 {"name": "settings-folders-crates", "route": "#/settings/folders/%2FUsers%2Fyou%2FMusic%2FRekordbox%20Library", "scenario": "settings:crates", "steps": [{"wait": "[data-test=folders-crates-row]"}, {"eval": "(() => { const r = [...document.querySelectorAll('[data-test=folders-crates-row]')]; const off = r.filter((x) => x.getAttribute('aria-checked') === 'false').map((x) => x.textContent.trim()); if (r.length !== 6 || off.length !== 1 || !off[0].startsWith('Edits')) throw new Error(`expected 6 crates with Edits off, got ${r.length}, off: ${off}`); if (!document.querySelector('[data-test=folders-list] [aria-current]')) throw new Error('the picked folder has no wash'); })()"}, {"sleep": 400}]},
 {"name": "settings-folders-too-many", "route": "#/library/folder/%2FVolumes%2FExample%20Drive%2FAlbums", "scenario": "settings:crates", "steps": [{"wait": "[data-test=library-show-some]"}, {"click": "[data-test=library-show-some]"}, {"wait": "[data-test=folders-crates-too-many]"}, {"eval": "(() => { if (!location.hash.startsWith('#/settings/folders/')) throw new Error(`the link went to ${location.hash}`); const n = document.querySelectorAll('[data-test=folders-crates-row]').length; if (n !== 312) throw new Error(`expected 312 crate rows, got ${n}`); const picked = document.querySelector('[data-test=folders-list] [aria-current]'); if (!picked || !picked.closest('[data-test^=folders-list-row-]').textContent.includes('Albums')) throw new Error('Albums is not the picked folder'); })()"}, {"sleep": 400}]},
 {"name": "settings-folders-crates-busy", "route": "#/settings/folders/%2FUsers%2Fyou%2FMusic%2FRekordbox%20Library", "scenario": "settings:crates_busy", "steps": [{"wait": "[data-test=folders-crates-row]"}, {"click": "[data-test=folders-crates-row][aria-checked=true]"}, {"wait": ".toast.problem"}, {"eval": "(() => { const off = document.querySelectorAll('[data-test=folders-crates-row][aria-checked=false]').length; if (off !== 1) throw new Error(`the refused switch was not put back (${off} off)`); })()"}, {"sleep": 300}]},
 {"name": "settings-folders-crates-many-folders", "route": "#/settings/folders/%2FUsers%2Fyou%2FMusic%2FRekordbox%20Library", "scenario": "settings:crates_many_folders", "steps": [{"wait": "[data-test=folders-crates-row]"}, {"eval": "(() => { const rows = document.querySelectorAll('[data-test^=folders-list-row-]').length; if (rows !== 6) throw new Error(`expected 6 watched folders, got ${rows}`); const g = document.querySelector('[data-test=folders-crates]'); const list = document.querySelector('[data-test=folders-list]'); const min = parseFloat(getComputedStyle(g).minHeight); if (g.getBoundingClientRect().height < min - 1) throw new Error(`the crates group is ${g.getBoundingClientRect().height} px, under its minimum ${min}`); if (list.querySelector('.rows').scrollHeight <= list.querySelector('.rows').clientHeight) throw new Error('the folder list does not scroll'); if (!document.querySelector('[data-test=folders-list] [aria-current]')) throw new Error('the picked folder has no wash'); })()"}, {"sleep": 400}]}
]
